# Keep the dist tarball lean: ship only what a consumer runs.
# These stay in the git repo (browsable on GitHub) but are export-ignored
# from `composer require` downloads.

/.etruscan          export-ignore
/plugin             export-ignore
/.claude-plugin     export-ignore
/tests              export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CHANGELOG.md       export-ignore
/phpunit.xml        export-ignore
/phpstan.neon       export-ignore
/pint.json          export-ignore
/rector.php         export-ignore
/testbench.yaml     export-ignore

* text=auto eol=lf
